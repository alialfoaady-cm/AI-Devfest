# Copy to .env.local (git-ignored). Server-side only: never prefix these with NEXT_PUBLIC_.

# Which inspection adapter app/api/inspect/route.ts uses: "mock" (default, no credentials) or "watsonx".
INSPECTION_PROVIDER=mock

# Google Maps JavaScript API key for the parking pin. This one is meant for the browser, so it is the
# one variable that takes the NEXT_PUBLIC_ prefix. Restrict it to your site in the Google Cloud console.
# Without it the map still loads, with Google's "for development purposes only" watermark.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# IBM watsonx.ai, read only on the server in lib/inspection/watsonx.ts. Fill in from the event's IBM account.
# API key: IBM Cloud > Manage > Access (IAM) > API keys. Project ID: watsonx.ai project > Manage > General.
# The project needs a Watson Machine Learning service associated (Manage > Services & integrations).
WATSONX_API_KEY=
# Region of the project, e.g. https://us-south.ml.cloud.ibm.com (default) or https://eu-de.ml.cloud.ibm.com
WATSONX_URL=
WATSONX_PROJECT_ID=
# Any image-chat model in your region. Default: meta-llama/llama-4-maverick-17b-128e-instruct-fp8
# Alternative: mistralai/mistral-small-3-1-24b-instruct-2503
WATSONX_MODEL_ID=
