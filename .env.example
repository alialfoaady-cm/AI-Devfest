# Copy to .env.local (git-ignored). Server-side only: never prefix these with NEXT_PUBLIC_.

# Which inspection adapter app/api/inspect/route.ts uses: "mock" (default, no credentials) or "watsonx".
INSPECTION_PROVIDER=mock

# Which AI search adapter app/api/search/route.ts uses: "mock" (default, a word matcher) or "watsonx"
# (IBM Granite, ibm/granite-4-h-small; needs the WATSONX_ values below). If IBM fails, search falls back to the matcher.
SEARCH_PROVIDER=mock

# Google Maps JavaScript API key for the parking pin. This one is meant for the browser, so it is the
# one variable that takes the NEXT_PUBLIC_ prefix. Restrict it to your site in the Google Cloud console.
# Without it the map still loads, with Google's "for development purposes only" watermark.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# IBM watsonx.ai. Only read on the server, in app/api/inspect/route.ts and app/api/search/route.ts. Fill in from the event's IBM account.
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
# The vision model for the photo check. Tested working on 2026-11-13 in us-south with images:
# meta-llama/llama-4-maverick-17b-128e-instruct-fp8 and mistralai/mistral-small-3-1-24b-instruct-2503.
WATSONX_MODEL_ID=
